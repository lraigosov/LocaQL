<?xml version="1.0" encoding="UTF-8"?>
<!--
  Official com.google.cloud:google-cloud-bigquery smoke test against
  LocaQL, mirroring test/clients/python/persistent_ddl_dml.py,
  test/clients/node/persistent_ddl_dml.js and
  test/clients/go/persistent_ddl_dml.go so every official client exercises
  the same real server behavior. A standalone Maven project (not part of
  the repo's Go modules) so its dependency tree stays isolated, matching
  the same isolation convention already used for the Python/Node/Go
  conformance clients.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>com.locaql.test</groupId>
  <artifactId>locaql-java-client-conformance</artifactId>
  <version>0.0.0</version>
  <packaging>jar</packaging>

  <properties>
    <maven.compiler.release>17</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
  </properties>

  <dependencies>
    <dependency>
      <groupId>com.google.cloud</groupId>
      <artifactId>google-cloud-bigquery</artifactId>
      <version>2.67.0</version>
    </dependency>
  </dependencies>

  <build>
    <finalName>locaql-java-client-conformance</finalName>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-shade-plugin</artifactId>
        <version>3.6.0</version>
        <executions>
          <execution>
            <phase>package</phase>
            <goals>
              <goal>shade</goal>
            </goals>
            <configuration>
              <transformers>
                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                  <mainClass>com.locaql.test.PersistentDdlDml</mainClass>
                </transformer>
              </transformers>
              <!-- Some transitive dependencies ship signed JARs; merging
                   their class files into one shaded JAR without dropping
                   the now-invalid signature files fails with "Invalid
                   signature file digest for Manifest main attributes" —
                   the shaded JAR isn't the original signed artifact, so the
                   old signature can never actually verify. -->
              <filters>
                <filter>
                  <artifact>*:*</artifact>
                  <excludes>
                    <exclude>META-INF/*.SF</exclude>
                    <exclude>META-INF/*.DSA</exclude>
                    <exclude>META-INF/*.RSA</exclude>
                  </excludes>
                </filter>
              </filters>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
