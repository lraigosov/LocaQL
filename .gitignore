# directories)
/locaql
/locaql-ui
/locaql-bench
test/clients/dbt/target/

# Conformance runner output (test/conformance/cases/*.yaml are the versioned
# test definitions; everything under reports/ is generated by running them —
# see README: Conformance Baseline — and goes stale between runs)
test/conformance/reports/
